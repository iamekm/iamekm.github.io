<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>B made planning: Gantt + severity</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/luxon/3.5.0/luxon.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>

<script>
  console.log("XLSX:", typeof XLSX);
  console.log("Luxon:", typeof luxon);
  console.log("d3:", typeof d3);
</script>

  <style>
    :root {
      --bg: #0b0c10;
      --panel: #11131a;
      --text: #e7e7e7;
      --muted: #a7a7a7;
      --grid: #2a2f3a;
      --accent: #7aa2ff;
      --warn: #ffb86b;
      --bad: #ff6b6b;
      --good: #6bffb3;
    }

    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
      background: var(--bg);
      color: var(--text);
    }

    header {
      padding: 16px 18px;
      border-bottom: 1px solid var(--grid);
      background: linear-gradient(180deg, #0e1018, #0b0c10);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    header h1 {
      margin: 0 0 6px 0;
      font-size: 18px;
      font-weight: 650;
      letter-spacing: 0.2px;
    }

    header p {
      margin: 0;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.35;
    }

    .wrap {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 12px;
      padding: 12px;
    }

    @media (max-width: 1050px) {
      .wrap { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--grid);
      border-radius: 14px;
      padding: 12px;
      box-shadow: 0 8px 22px rgba(0,0,0,0.25);
    }

    .card h2 {
      margin: 0 0 10px 0;
      font-size: 14px;
      font-weight: 650;
      color: #f1f1f1;
    }

    label {
      display: block;
      font-size: 12px;
      color: var(--muted);
      margin: 10px 0 6px;
    }

    input[type="file"] {
      width: 100%;
      padding: 10px;
      border-radius: 10px;
      border: 1px dashed #3a4152;
      background: #0f1118;
      color: var(--text);
    }

    select, input[type="date"], input[type="number"], button {
      width: 100%;
      box-sizing: border-box;
      padding: 9px 10px;
      border-radius: 10px;
      border: 1px solid #2e3441;
      background: #0f1118;
      color: var(--text);
      outline: none;
    }

    select[multiple] {
      height: 120px;
      padding: 8px;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .pill {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 999px;
      border: 1px solid #2e3441;
      background: #0f1118;
      color: var(--muted);
      font-size: 12px;
      margin-right: 8px;
      margin-top: 8px;
    }

    .btnrow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 10px;
    }

    button {
      cursor: pointer;
      font-weight: 650;
      border: 1px solid #33405a;
      background: rgba(122,162,255,0.14);
    }

    button.secondary {
      background: #0f1118;
      border: 1px solid #2e3441;
      font-weight: 600;
      color: var(--muted);
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .status {
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.35;
      white-space: pre-wrap;
    }

    .vizgrid {
      display: grid;
      grid-template-rows: auto auto;
      gap: 12px;
    }

    .viz {
      position: relative;
    }

    .toolbar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin: 8px 0 0 0;
    }

    .toolbar .pill strong { color: var(--text); font-weight: 650; }

    .svgwrap {
      width: 100%;
      overflow: auto;
      border-radius: 12px;
      border: 1px solid var(--grid);
      background: #0a0b11;
    }

    .legend {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
    }

    .swatch {
      width: 10px;
      height: 10px;
      border-radius: 3px;
      display: inline-block;
      border: 1px solid #2e3441;
      margin-right: 6px;
    }

    .note {
      margin-top: 8px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.35;
    }

    .kpi {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 10px;
    }

    .kpi .box {
      border: 1px solid var(--grid);
      border-radius: 12px;
      padding: 10px;
      background: #0f1118;
    }

    .kpi .box .big {
      font-size: 18px;
      font-weight: 750;
      color: #f2f2f2;
      margin-bottom: 4px;
    }

    .kpi .box .small {
      font-size: 12px;
      color: var(--muted);
    }

    .axis text { fill: #aeb6c6; font-size: 11px; }
    .axis path, .axis line { stroke: #2a2f3a; }

    .grid line { stroke: #1b1f2a; }

    .task {
      stroke: rgba(0,0,0,0.35);
      stroke-width: 1;
      rx: 5;
      ry: 5;
    }

    .task:hover { stroke: rgba(255,255,255,0.65); stroke-width: 1.2; }

    .tooltip {
      position: absolute;
      pointer-events: none;
      z-index: 20;
      background: rgba(17,19,26,0.96);
      border: 1px solid #2e3441;
      border-radius: 12px;
      padding: 10px;
      color: #f1f1f1;
      font-size: 12px;
      max-width: 320px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.35);
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 120ms ease, transform 120ms ease;
      white-space: pre-wrap;
    }

    .tooltip strong { font-weight: 750; }

    .heatcell {
      stroke: #151824;
      stroke-width: 1;
      rx: 5;
      ry: 5;
    }
  
    .stats-wrap {
      width: 100%;
      overflow: auto;
      border-radius: 12px;
      border: 1px solid var(--grid);
      background: #0a0b11;
      padding: 8px;
    }

    table.stats-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    .stats-table th {
      text-align: left;
      padding: 8px;
      border-bottom: 1px solid var(--grid);
      color: #aeb6c6;
      font-weight: 650;
      position: sticky;
      top: 0;
      background: #0a0b11;
      z-index: 1;
    }

    .stats-table td {
      padding: 8px;
      border-bottom: 1px solid #171b24;
      color: #e7e7e7;
      vertical-align: top;
    }

    .stats-table td.num,
    .stats-table th.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .stats-kpi {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 10px;
    }

    .stats-kpi .box {
      border: 1px solid var(--grid);
      border-radius: 12px;
      padding: 10px;
      background: #0f1118;
    }

    .stats-kpi .box .big {
      font-size: 16px;
      font-weight: 750;
      color: #f2f2f2;
      margin-bottom: 4px;
    }

    .stats-kpi .box .small {
      font-size: 12px;
      color: var(--muted);
    }


    .courseHeader { pointer-events: none; }
</style>
</head>

<body>
<header>
  <h1>B made workload planner: filterable Gantt + severity heat map</h1>
  <p>Load Excel file(s), filter by course (sheet), task type, date range, likelihood, and student bucket. Severity is calculated from likelihood and student bucket.</p>
</header>

<div class="wrap">
  <div class="card">
    <h2>1) Load data</h2>
    <input id="file" type="file" multiple accept=".xlsx,.xls" />

    <div class="kpi">
      <div class="box">
        <div class="big" id="kpiTasks">0</div>
        <div class="small">Tasks loaded</div>
      </div>
      <div class="box">
        <div class="big" id="kpiCourses">0</div>
        <div class="small">Courses (sheets)</div>
      </div>
    </div>

    <div class="status" id="status">No file loaded.</div>

    <h2 style="margin-top:14px;">2) Filters</h2>

    <label>Courses (sheets)</label>
    <select id="filterCourse" multiple></select>

    <label>Type of task</label>
    <select id="filterType" multiple></select>

    <label>Location</label>
    <select id="filterLocation" multiple></select>


    <div class="row">
      <div>
        <label>Year group</label>
        <select id="filterYear">
          <option value="">All</option>
        </select>
      </div>
      <div>
        <label>Student bucket</label>
        <select id="filterStudents">
          <option value="">All</option>
          <option value="1-10">1-10</option>
          <option value="10-20">10-20</option>
          <option value="21+">21+</option>
        </select>
      </div>
    </div>

    <div class="row">
      <div>
        <label>Likelihood minimum (1 to 3)</label>
        <select id="filterLikemin">
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
        </select>
      </div>
      <div>
        <label>Likelihood maximum (1 to 3)</label>
        <select id="filterLikemax">
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3" selected>3</option>
        </select>
      </div>
    </div>

    <div class="row">
      <div>
        <label>Date from</label>
        <input id="filterFrom" type="date" />
      </div>
      <div>
        <label>Date to</label>
        <input id="filterTo" type="date" />
      </div>
    </div>

    <div class="btnrow">
      <button id="apply" disabled>Apply filters</button>
      <button id="reset" class="secondary" disabled>Reset</button>
    </div>

    <div class="btnrow">
      <button id="exportGantt" class="secondary" disabled>Export Gantt as PNG</button>
      <button id="exportHeat" class="secondary" disabled>Export severity chart as PNG</button>
    </div>

    <div class="note">
      <div class="legend">
        <span><span class="swatch" style="background:rgba(122,162,255,0.70)"></span>Likelihood 1</span>
        <span><span class="swatch" style="background:rgba(255,184,107,0.70)"></span>Likelihood 2</span>
        <span><span class="swatch" style="background:rgba(255,107,107,0.72)"></span>Likelihood 3</span>
      </div>
      <div class="note">
        Severity weighting:
        1-10 → 1, 10-20 → 2, 21+ → 3.
        Severity per task day = likelihood × bucket weight.
      </div>
    </div>
  </div>

  <div class="vizgrid">
    <div class="card viz">
      <h2>Gantt chart</h2>
      <div class="toolbar" id="ganttMeta"></div>
      <div class="svgwrap">
        <svg id="gantt" width="1400" height="620"></svg>
      </div>
      <div class="note">Tip: scroll horizontally for longer timelines. Hover tasks for details.</div>
      <div class="tooltip" id="tooltip"></div>
    </div>

    <div class="card viz">
      <h2>Severity line graph (weekly)</h2>
      <div class="toolbar" id="heatMeta"></div>
      <div class="svgwrap">
        <svg id="heat" width="1400" height="520"></svg>
      </div>
      <div class="note">Line graph shows weekly total severity per course (sheet).</div>

      <h2 style="margin-top:14px;">Severity heat map (weekly blocks)</h2>
      <div class="svgwrap">
        <svg id="heatBlocks" width="1400" height="360"></svg>
      </div>
      <div class="note">Blocks show weekly severity totals (darker = busier). Scroll to see all courses or weeks.</div>

      <h2 style="margin-top:14px;">Total severity curve (all programmes)</h2>
      <div class="svgwrap">
        <svg id="totalCurve" width="1400" height="260"></svg>
      </div>
      <div class="note">Single curve that sums weekly severity across all programmes, using the current filters.</div>

      <h2 style="margin-top:14px;">Severity curves by location</h2>
      <div class="svgwrap">
        <svg id="locationCurves" width="1400" height="360"></svg>
      </div>
      <div class="note">Weekly severity summed by location (top locations shown; remainder grouped as Other).</div>

    </div>

    <div class="card viz">
      <h2>Heaviest users by course</h2>
      <div class="toolbar" id="statsMeta"></div>
      <div id="courseStatsBody" class="stats-wrap"></div>
      <div class="note">Totals reflect the current filters. Total severity sums (likelihood × student weight) for every day in each activity range.</div>
    </div>
  </div>
</div>

<script>
(() => {
  const DateTime = luxon.DateTime;

  // --- column name normalisation ---
  function normKey(s) {
    return String(s || "")
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ")
      .replace(/[\u2013\u2014]/g, "-");
  }

  // Accepts minor variations in headings
const COLMAP = {
  module: ["module", "module name", "module title", "modulename"],
  year: ["year", "year group", "yeargroup"],
  type: ["task", "type of task", "task type", "type", "activity type"],
  likelihood: [
    "likelihood of b-made input expected",
    "a measure of likelihood of input needed (from 1 to 3)",
    "likelihood",
    "input likelihood",
    "likelihood of input needed"
  ],
  students: [
    "level of b-made input expected",
    "a measure of number of students (1-10, 10-20, 21+)",
    "number of students",
    "students",
    "student bucket",
    "cohort size"
  ],
  start: ["activity start", "date of activity start", "activity start date", "start date", "date start"],
  finish: ["activity end", "date of activity finish", "activity end date", "finish date", "end date", "date finish"],
  location: ["location", "site", "room", "space", "campus"]
};

  function findCol(headers, wantList) {
    for (const want of wantList) {
      const idx = headers.findIndex(h => normKey(h) === normKey(want));
      if (idx >= 0) return idx;
    }
    // fallback: fuzzy contains
    for (let i = 0; i < headers.length; i++) {
      const h = normKey(headers[i]);
      for (const want of wantList) {
        const w = normKey(want);
        if (h.includes(w) || w.includes(h)) return i;
      }
    }
    return -1;
  }

  function excelDateToISO(v) {
    // v may be a Date, a number serial, or a string.
    if (v == null || v === "") return null;

    if (v instanceof Date) {
      const dt = DateTime.fromJSDate(v, { zone: "utc" });
      return dt.isValid ? dt.toISODate() : null;
    }

    if (typeof v === "number") {
      // Excel serial date (SheetJS uses 1900-based)
      const parsed = XLSX.SSF.parse_date_code(v);
      if (!parsed) return null;
      const dt = DateTime.utc(parsed.y, parsed.m, parsed.d);
      return dt.isValid ? dt.toISODate() : null;
    }

    const s = String(v).trim();
    // Try ISO first
    let dt = DateTime.fromISO(s, { zone: "utc" });
    if (dt.isValid) return dt.toISODate();

    // Try common UK formats
    const formats = ["d/M/yyyy", "dd/MM/yyyy", "d/M/yy", "dd/MM/yy", "d-M-yyyy", "dd-MM-yyyy"];
    for (const f of formats) {
      dt = DateTime.fromFormat(s, f, { zone: "utc" });
      if (dt.isValid) return dt.toISODate();
    }
    return null;
  }

  function clampInt(x, lo, hi) {
    const n = Number(x);
    if (!Number.isFinite(n)) return null;
    return Math.max(lo, Math.min(hi, Math.round(n)));
  }

  function studentWeight(bucket) {
    const b = String(bucket || "").trim();
    if (b === "1-10") return 1;
    if (b === "10-20") return 2;
    if (b === "21+") return 3;
    // fallback if numbers appear
    const m = b.match(/(\d+)\s*\+?/);
    if (m) {
      const n = Number(m[1]);
      if (n <= 10) return 1;
      if (n <= 20) return 2;
      return 3;
    }
    return 1;
  }

  function likelihoodColour(lik) {
    if (lik === 1) return "rgba(122,162,255,0.70)";
    if (lik === 2) return "rgba(255,184,107,0.70)";
    return "rgba(255,107,107,0.72)";
  }

  // --- state ---
  let allTasks = [];
  let filteredTasks = [];

  // --- dom ---
  const elFile = document.getElementById("file");
  const elStatus = document.getElementById("status");
  const elApply = document.getElementById("apply");
  const elReset = document.getElementById("reset");

  const elCourse = document.getElementById("filterCourse");
  const elType = document.getElementById("filterType");
  const elLocation = document.getElementById("filterLocation");
  const elYear = document.getElementById("filterYear");
  const elStudents = document.getElementById("filterStudents");
  const elLikemin = document.getElementById("filterLikemin");
  const elLikemax = document.getElementById("filterLikemax");
  const elFrom = document.getElementById("filterFrom");
  const elTo = document.getElementById("filterTo");

  const kpiTasks = document.getElementById("kpiTasks");
  const kpiCourses = document.getElementById("kpiCourses");

  const svgG = d3.select("#gantt");
  const svgH = d3.select("#heat");

  const ganttMeta = document.getElementById("ganttMeta");
  const heatMeta = document.getElementById("heatMeta");
  const statsMeta = document.getElementById("statsMeta");

  const elExportGantt = document.getElementById("exportGantt");
  const elExportHeat = document.getElementById("exportHeat");

  const tooltip = document.getElementById("tooltip");

  function setStatus(msg) {
    elStatus.textContent = msg;
  }

  function setEnabled(yes) {
    elApply.disabled = !yes;
    elReset.disabled = !yes;
    elExportGantt.disabled = !yes;
    elExportHeat.disabled = !yes;
  }

  function fillSelectMultiple(select, values) {
    select.innerHTML = "";
    for (const v of values) {
      const opt = document.createElement("option");
      opt.value = v;
      opt.textContent = v;
      opt.selected = true;
      select.appendChild(opt);
    }
  }

  function selectedValues(select) {
    return Array.from(select.options).filter(o => o.selected).map(o => o.value);
  }

  function uniqueSorted(arr) {
    return Array.from(new Set(arr.filter(v => v != null && String(v).trim() !== "")))
      .map(v => String(v))
      .sort((a, b) => a.localeCompare(b, "en-GB", { numeric: true }));
  }

  function formatRangeISO(a, b) {
    if (!a || !b) return "";
    return `${a} → ${b}`;
  }

  function parseWorkbookToTasks(workbook, fileName) {
    const tasks = [];
    for (const sheetName of workbook.SheetNames) {
      const sheet = workbook.Sheets[sheetName];
      if (!sheet) continue;

      const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, raw: true, defval: "" });
      if (!rows || rows.length < 2) continue;

      const headers = rows[0].map(h => String(h || "").trim());
      const idxModule = findCol(headers, COLMAP.module);
      const idxYear = findCol(headers, COLMAP.year);
      const idxType = findCol(headers, COLMAP.type);
      const idxLike = findCol(headers, COLMAP.likelihood);
      const idxStud = findCol(headers, COLMAP.students);
      const idxStart = findCol(headers, COLMAP.start);
      const idxFin = findCol(headers, COLMAP.finish);
      const idxLoc = findCol(headers, COLMAP.location);

      const required = [idxModule, idxYear, idxType, idxLike, idxStud, idxStart, idxFin];
      if (required.some(i => i < 0)) {
        // skip sheets without the needed structure
        continue;
      }

      for (let r = 1; r < rows.length; r++) {
        const row = rows[r];
        if (!row || row.length === 0) continue;

        const moduleName = String(row[idxModule] || "").trim();
        const yearGroup = clampInt(row[idxYear], 1, 9); // architecture years vary, keep generous
        const type = String(row[idxType] || "").trim();
        const likelihood = clampInt(row[idxLike], 1, 3);
        const studentsBucket = String(row[idxStud] || "").trim();
        const location = (idxLoc >= 0) ? String(row[idxLoc] || "").trim() : "";
        const startISO = excelDateToISO(row[idxStart]);
        const finishISO = excelDateToISO(row[idxFin]);

        const hasAny = moduleName || type || startISO || finishISO;
        if (!hasAny) continue;

        if (!moduleName || !type || !startISO || !finishISO || !likelihood) {
          // keep but mark as invalid to report
          tasks.push({
            valid: false,
            file: fileName,
            course: `${fileName} · ${sheetName}`,
            moduleName,
            yearGroup,
            type,
            likelihood,
            studentsBucket,
            location,
            startISO,
            finishISO
          });
          continue;
        }

        const s = DateTime.fromISO(startISO, { zone: "utc" });
        const f = DateTime.fromISO(finishISO, { zone: "utc" });
        if (!s.isValid || !f.isValid) {
          tasks.push({ valid: false, file: fileName, course: sheetName, moduleName, yearGroup, type, likelihood, studentsBucket, location, startISO, finishISO });
          continue;
        }

        const start = s.startOf("day");
        const finish = f.startOf("day");
        const end = finish < start ? start : finish;

        tasks.push({
          valid: true,
          file: fileName,
          course: sheetName,
          moduleName,
          yearGroup,
          type,
          likelihood,
          studentsBucket,
          location,
          startISO: start.toISODate(),
          finishISO: end.toISODate(),
          severityPerDay: likelihood * studentWeight(studentsBucket),
        });
      }
    }
    return tasks;
  }

  function refreshFilterOptions() {
    const valid = allTasks.filter(t => t.valid);

    const courses = uniqueSorted(valid.map(t => t.course));
    const types = uniqueSorted(valid.map(t => t.type));

    fillSelectMultiple(elCourse, courses);
    fillSelectMultiple(elType, types);

    

    const locations = uniqueSorted(valid.map(t => (t.location && String(t.location).trim()) ? String(t.location).trim() : "—"));
    fillSelectMultiple(elLocation, locations);
// year group single select
    const years = uniqueSorted(valid.map(t => t.yearGroup).filter(v => v != null));
    elYear.innerHTML = `<option value="">All</option>` + years.map(y => `<option value="${y}">${y}</option>`).join("");

    // date range defaults
    const starts = valid.map(t => t.startISO).filter(Boolean).sort();
    const ends = valid.map(t => t.finishISO).filter(Boolean).sort();
    if (starts.length) elFrom.value = starts[0];
    if (ends.length) elTo.value = ends[ends.length - 1];

    kpiTasks.textContent = String(valid.length);
    kpiCourses.textContent = String(courses.length);
  }

  function applyFilters() {
    const courses = new Set(selectedValues(elCourse));
    const types = new Set(selectedValues(elType));
    const locations = new Set(selectedValues(elLocation));
    const year = elYear.value ? Number(elYear.value) : null;
    const students = elStudents.value || null;

    const likeMin = Number(elLikemin.value || 1);
    const likeMax = Number(elLikemax.value || 3);

    const from = elFrom.value || null;
    const to = elTo.value || null;

    const valid = allTasks.filter(t => t.valid);

    filteredTasks = valid.filter(t => {
      if (courses.size && !courses.has(t.course)) return false;
      if (types.size && !types.has(t.type)) return false;
      const loc = (t.location && String(t.location).trim()) ? String(t.location).trim() : "—";
      if (locations.size && !locations.has(loc)) return false;
      if (year != null && t.yearGroup !== year) return false;
      if (students && String(t.studentsBucket).trim() !== students) return false;
      if (t.likelihood < likeMin || t.likelihood > likeMax) return false;

      // overlap test with filter date window
      if (from && t.finishISO < from) return false;
      if (to && t.startISO > to) return false;

      return true;
    });

    drawAll();
  }

  function resetFilters() {
    refreshFilterOptions();
    elStudents.value = "";
    elLikemin.value = "1";
    elLikemax.value = "3";
    applyFilters();
  }

