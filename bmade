  const weeks = [];
  for (let d = minDT; d <= maxDT; d = d.plus({ weeks: 1 })) {
    weeks.push(d.toISODate());
  }

  const totals = new Map(); // weekISO -> value

  for (const t of tasks) {
    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
    if (!s.isValid || !f.isValid) continue;

    for (let d = s; d <= f; d = d.plus({ days: 1 })) {
      const w = startOfISOWeek(d).toISODate();
      totals.set(w, (totals.get(w) || 0) + (t.severityPerDay || 0));
    }
  }

  const data = weeks.map(w => ({
    weekISO: w,
    date: DateTime.fromISO(w, { zone: "utc" }).toJSDate(),
    value: totals.get(w) || 0
  }));

  const maxVal = d3.max(data, d => d.value) || 1;

  const margin = { top: 24, right: 20, bottom: 36, left: 60 };
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const x = d3.scaleTime()
    .domain([data[0].date, DateTime.fromISO(weeks[weeks.length - 1], { zone: "utc" }).plus({ weeks: 1 }).toJSDate()])
    .range([0, innerW]);

  const y = d3.scaleLinear().domain([0, maxVal]).nice().range([innerH, 0]);

  const g = svgT.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

  g.append("g")
    .attr("class", "grid")
    .call(d3.axisLeft(y).ticks(4).tickSize(-innerW).tickFormat(() => ""));

  g.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${innerH})`)
    .call(d3.axisBottom(x).ticks(d3.timeWeek.every(2)).tickFormat(d3.timeFormat("%d %b")));

  g.append("g")
    .attr("class", "axis")
    .call(d3.axisLeft(y).ticks(4));

  const line = d3.line()
    .x(d => x(d.date))
    .y(d => y(d.value))
    .curve(d3.curveMonotoneX);

  g.append("path")
    .datum(data)
    .attr("fill", "none")
    .attr("stroke", "rgba(122,162,255,0.95)")
    .attr("stroke-width", 2.5)
    .attr("d", line);

  g.selectAll("circle")
    .data(data)
    .enter()
    .append("circle")
    .attr("cx", d => x(d.date))
    .attr("cy", d => y(d.value))
    .attr("r", 3)
    .attr("fill", "rgba(122,162,255,0.95)")
    .on("mousemove", function(evt, d) {
      const rect = evt.currentTarget.ownerSVGElement.getBoundingClientRect();
      const xPos = evt.clientX - rect.left + 14;
      const yPos = evt.clientY - rect.top + 14;
      const dt = DateTime.fromISO(d.weekISO, { zone: "utc" });

      tooltip.innerHTML =
        `<strong>All programmes</strong>\n` +
        `Week commencing: ${dt.toFormat("dd LLL yyyy")}\n` +
        `Weekly severity: ${d.value.toFixed(0)}`;

      tooltip.style.opacity = "1";
      tooltip.style.transform = "translateY(0px)";
      tooltip.style.left = `${Math.min(xPos, rect.width - 340)}px`;
      tooltip.style.top = `${Math.min(yPos, rect.height - 160)}px`;
    })
    .on("mouseleave", hideTooltip);

  svgT.append("text")
    .attr("x", margin.left)
    .attr("y", 16)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Total weekly severity (all programmes).");
}

function drawLocationCurves(tasks) {
  const svgL = d3.select("#locationCurves");
  if (svgL.empty()) return;

  svgL.selectAll("*").remove();

  const width = 1400;
  const height = 360;
  svgL.attr("width", width).attr("height", height);

  if (!tasks || !tasks.length) return;

  const minISO = d3.min(tasks, d => d.startISO);
  const maxISO = d3.max(tasks, d => d.finishISO);

  const minDT = startOfISOWeek(DateTime.fromISO(minISO, { zone: "utc" }));
  const maxDT = startOfISOWeek(DateTime.fromISO(maxISO, { zone: "utc" }));

  const weeks = [];
  for (let d = minDT; d <= maxDT; d = d.plus({ weeks: 1 })) {
    weeks.push(d.toISODate());
  }

  // Aggregate by location-week
  const totals = new Map(); // `${loc}||${week}` -> value
  const locTotals = new Map(); // loc -> total

  function locName(t) {
    const raw = String(t.location || "").trim();
    return raw ? raw : "Unspecified";
  }

  for (const t of tasks) {
    const loc = locName(t);
    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
    if (!s.isValid || !f.isValid) continue;

    for (let d = s; d <= f; d = d.plus({ days: 1 })) {
      const w = startOfISOWeek(d).toISODate();
      const k = `${loc}||${w}`;
      const add = (t.severityPerDay || 0);
      totals.set(k, (totals.get(k) || 0) + add);
      locTotals.set(loc, (locTotals.get(loc) || 0) + add);
    }
  }

  // pick top locations by overall severity, group the rest as "Other"
  const ranked = Array.from(locTotals.entries()).sort((a, b) => b[1] - a[1]);
  const topN = 8;
  const keep = new Set(ranked.slice(0, topN).map(d => d[0]));
  const hasOther = ranked.length > topN;

  const locations = ranked.slice(0, topN).map(d => d[0]);
  if (hasOther) locations.push("Other");

  // build series
  const series = locations.map(loc => {
    const values = weeks.map(w => {
      if (loc === "Other") {
        // sum all non-kept locations
        let v = 0;
        for (const [name] of ranked.slice(topN)) {
          v += totals.get(`${name}||${w}`) || 0;
        }
        return { weekISO: w, date: DateTime.fromISO(w, { zone: "utc" }).toJSDate(), value: v };
      }
      return {
        weekISO: w,
        date: DateTime.fromISO(w, { zone: "utc" }).toJSDate(),
        value: totals.get(`${loc}||${w}`) || 0
      };
    });
    return { loc, values };
  });

  const maxVal = d3.max(series, s => d3.max(s.values, v => v.value)) || 1;

  const margin = { top: 30, right: 220, bottom: 40, left: 60 };
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const x = d3.scaleTime()
    .domain([DateTime.fromISO(weeks[0], { zone: "utc" }).toJSDate(),
             DateTime.fromISO(weeks[weeks.length - 1], { zone: "utc" }).plus({ weeks: 1 }).toJSDate()])
    .range([0, innerW]);

  const y = d3.scaleLinear().domain([0, maxVal]).nice().range([innerH, 0]);

  const g = svgL.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

  g.append("g")
    .attr("class", "grid")
    .call(d3.axisLeft(y).ticks(5).tickSize(-innerW).tickFormat(() => ""));

  g.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${innerH})`)
    .call(d3.axisBottom(x).ticks(d3.timeWeek.every(2)).tickFormat(d3.timeFormat("%d %b")));

  g.append("g")
    .attr("class", "axis")
    .call(d3.axisLeft(y).ticks(5));

  const line = d3.line()
    .x(d => x(d.date))
    .y(d => y(d.value))
    .curve(d3.curveMonotoneX);

  const colour = d3.scaleOrdinal()
    .domain(locations)
    .range(d3.schemeTableau10.concat(d3.schemeSet3).slice(0, Math.max(10, locations.length)));

  const linesG = g.append("g");

  linesG.selectAll("path")
    .data(series)
    .enter()
    .append("path")
    .attr("fill", "none")
    .attr("stroke-width", 2)
    .attr("stroke", d => colour(d.loc))
    .attr("d", d => line(d.values));

  // points for hover
  const points = linesG.selectAll("g.points")
    .data(series)
    .enter()
    .append("g")
    .attr("class", "points");

  points.selectAll("circle")
    .data(d => d.values.map(v => ({ ...v, loc: d.loc })))
    .enter()
    .append("circle")
    .attr("cx", d => x(d.date))
    .attr("cy", d => y(d.value))
    .attr("r", 3)
    .attr("fill", d => colour(d.loc))
    .on("mousemove", function(evt, d) {
      const rect = evt.currentTarget.ownerSVGElement.getBoundingClientRect();
      const xPos = evt.clientX - rect.left + 14;
      const yPos = evt.clientY - rect.top + 14;
      const dt = DateTime.fromISO(d.weekISO, { zone: "utc" });

      tooltip.innerHTML =
        `<strong>${d.loc}</strong>\n` +
        `Week commencing: ${dt.toFormat("dd LLL yyyy")}\n` +
        `Weekly severity: ${d.value.toFixed(0)}`;

      tooltip.style.opacity = "1";
      tooltip.style.transform = "translateY(0px)";
      tooltip.style.left = `${Math.min(xPos, rect.width - 340)}px`;
      tooltip.style.top = `${Math.min(yPos, rect.height - 160)}px`;
    })
    .on("mouseleave", hideTooltip);

  // legend (right side)
  const legend = svgL.append("g")
    .attr("transform", `translate(${margin.left + innerW + 14},${margin.top})`);

  legend.append("text")
    .attr("x", 0)
    .attr("y", 0)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Locations");

  const legendItems = legend.selectAll("g.item")
    .data(locations)
    .enter()
    .append("g")
    .attr("class", "item")
    .attr("transform", (d, i) => `translate(0,${16 + i * 16})`);

  legendItems.append("rect")
    .attr("x", 0)
    .attr("y", -10)
    .attr("width", 10)
    .attr("height", 10)
    .attr("rx", 3)
    .attr("ry", 3)
    .attr("fill", d => colour(d));

  legendItems.append("text")
    .attr("x", 16)
    .attr("y", -2)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 11)
    .text(d => d);

  svgL.append("text")
    .attr("x", margin.left)
    .attr("y", 18)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Weekly severity by location (top locations).");
}


// --- export helpers (SVG to PNG) ---
  async function exportSvgToPng(svgEl, fileName) {
    const svg = svgEl.cloneNode(true);

    // ensure explicit size
    const w = svgEl.getAttribute("width") || svgEl.clientWidth;
    const h = svgEl.getAttribute("height") || svgEl.clientHeight;
    svg.setAttribute("width", w);
    svg.setAttribute("height", h);

    const xml = new XMLSerializer().serializeToString(svg);
    const svg64 = btoa(unescape(encodeURIComponent(xml)));
    const image64 = "data:image/svg+xml;base64," + svg64;

    const img = new Image();
    img.src = image64;
    await img.decode();

    const canvas = document.createElement("canvas");
    canvas.width = Number(w);
    canvas.height = Number(h);
    const ctx = canvas.getContext("2d");

    // background fill for dark theme
    ctx.fillStyle = "#0b0c10";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0);

    const a = document.createElement("a");
    a.download = fileName;
    a.href = canvas.toDataURL("image/png");
    a.click();
  }

  // --- event wiring ---
elFile.addEventListener("change", async (evt) => {
  const files = Array.from(evt.target.files || []);
  if (!files.length) return;

  setEnabled(false);
  setStatus("Loading…");

  try {
    allTasks = [];
    let invalidCount = 0;
    let sheetCount = 0;

    for (const f of files) {
      const data = await f.arrayBuffer();
      const wb = XLSX.read(data, { type: "array", cellDates: true });
      sheetCount += wb.SheetNames.length;

      const tasks = parseWorkbookToTasks(wb, f.name);
      invalidCount += tasks.filter(t => !t.valid).length;
      allTasks.push(...tasks);
    }

    const validCount = allTasks.filter(t => t.valid).length;
    const courses = uniqueSorted(allTasks.filter(t => t.valid).map(t => t.course));

    refreshFilterOptions();
    setEnabled(true);

    setStatus(
      `Loaded files: ${files.length}
Sheets scanned: ${sheetCount}
Courses detected (by sheet name): ${courses.length}
Valid tasks: ${validCount}
Rows needing attention (missing required cells): ${invalidCount}`
    );

    applyFilters();
  } catch (err) {
    console.error(err);
    setStatus(`Error while loading:\n${err && err.message ? err.message : String(err)}`);
    setEnabled(false);
  }
});


  elApply.addEventListener("click", () => applyFilters());
  elReset.addEventListener("click", () => resetFilters());

  elLikemin.addEventListener("change", () => {
    const a = Number(elLikemin.value);
    const b = Number(elLikemax.value);
    if (a > b) elLikemax.value = String(a);
  });

  elLikemax.addEventListener("change", () => {
    const a = Number(elLikemin.value);
    const b = Number(elLikemax.value);
    if (b < a) elLikemin.value = String(b);
  });

  elExportGantt.addEventListener("click", async () => {
    await exportSvgToPng(document.getElementById("gantt"), "gantt.png");
  });

  elExportHeat.addEventListener("click", async () => {
    await exportSvgToPng(document.getElementById("heat"), "severity.png");
  });

})();
