function drawGantt(tasks) {
  svgG.selectAll("*").remove();

  const width = 1400;

  if (!tasks.length) {
    svgG.attr("width", width).attr("height", 620);
    return;
  }

  // Helpers for label management
  function shortLabel(s, max = 26) {
    const t = String(s || "").trim();
    if (t.length <= max) return t;
    return t.slice(0, Math.max(0, max - 1)) + "…";
  }

  function splitLaneLabel(lane) {
    const parts = String(lane || "").split(" · ");
    return {
      course: parts[0] || String(lane || ""),
      module: parts.slice(1).join(" · ") || ""
    };
  }

  // lanes: course + module
  const laneKey = d => `${d.course} · ${d.moduleName}`;
  const lanes = uniqueSorted(tasks.map(laneKey));

  // Dynamic height so labels do not overlap when there are many lanes
  const rowH = 18; // pixels per lane row (incl padding)
  const height = Math.max(620, 120 + lanes.length * rowH);

  svgG.attr("width", width).attr("height", height);

  // time domain
  const minISO = d3.min(tasks, d => d.startISO);
  const maxISO = d3.max(tasks, d => d.finishISO);

  const minDate = DateTime.fromISO(minISO, { zone: "utc" }).toJSDate();
  const maxDate = DateTime.fromISO(maxISO, { zone: "utc" }).plus({ days: 1 }).toJSDate();

  // Increase left margin to make room for course headers + module labels
  const margin = { top: 28, right: 16, bottom: 30, left: 360 };
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const x = d3.scaleTime().domain([minDate, maxDate]).range([0, innerW]);
  const y = d3.scaleBand().domain(lanes).range([0, innerH]).paddingInner(0.16);

  const g = svgG.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

  // background grid by week
  const xAxis = d3.axisBottom(x).ticks(d3.timeWeek.every(1)).tickFormat(d3.timeFormat("%d %b"));

  // Show only module name (shortened) in the y-axis tick labels
  const yAxis = d3.axisLeft(y)
    .tickSize(0)
    .tickFormat(d => {
      const { module } = splitLaneLabel(d);
      return shortLabel(module || d, 24);
    });

  g.append("g")
    .attr("class", "grid")
    .attr("transform", `translate(0,${innerH})`)
    .call(d3.axisBottom(x).ticks(d3.timeWeek.every(1)).tickSize(-innerH).tickFormat(() => ""));

  g.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${innerH})`)
    .call(xAxis);

  // y-axis
  g.append("g")
    .attr("class", "axis")
    .call(yAxis)
    .selectAll("text")
    .attr("fill", "#aeb6c6")
    .attr("font-size", 11);

  // Course headers: draw one label per course group (bold), aligned with the first lane in each course
  const laneMeta = lanes.map(l => ({ lane: l, ...splitLaneLabel(l) }));
  const grouped = d3.group(laneMeta, d => d.course);

  const firstLanePerCourse = Array.from(grouped, ([course, items]) => {
    // The lane with the smallest y-position for this course
    const topLane = items
      .map(i => i.lane)
      .sort((a, b) => (y(a) ?? 0) - (y(b) ?? 0))[0];
    return { course, lane: topLane };
  }).sort((a, b) => (y(a.lane) ?? 0) - (y(b.lane) ?? 0));

  g.append("g")
    .selectAll("text.courseHeader")
    .data(firstLanePerCourse)
    .enter()
    .append("text")
    .attr("class", "courseHeader")
    .attr("x", -350) // inside left margin area
    .attr("y", d => (y(d.lane) ?? 0) + 3)
    .attr("fill", "#f1f1f1")
    .attr("font-size", 12)
    .attr("font-weight", 700)
    .text(d => shortLabel(d.course, 30));

  // tasks
  const bars = g.append("g");

  bars.selectAll("rect")
    .data(tasks)
    .enter()
    .append("rect")
    .attr("class", "task")
    .attr("x", d => x(DateTime.fromISO(d.startISO, { zone: "utc" }).toJSDate()))
    .attr("y", d => (y(laneKey(d)) ?? 0) + 1)
    .attr("width", d => {
      const a = x(DateTime.fromISO(d.startISO, { zone: "utc" }).toJSDate());
      const b = x(DateTime.fromISO(d.finishISO, { zone: "utc" }).plus({ days: 1 }).toJSDate());
      return Math.max(2, b - a);
    })
    .attr("height", Math.max(10, y.bandwidth() - 2))
    .attr("fill", d => likelihoodColour(d.likelihood))
    .on("mousemove", function(evt, d) { showTooltip(evt, d); })
    .on("mouseleave", hideTooltip);

  // lane separators
  g.append("g")
    .selectAll("line")
    .data(lanes)
    .enter()
    .append("line")
    .attr("x1", 0)
    .attr("x2", innerW)
    .attr("y1", d => (y(d) ?? 0) + y.bandwidth())
    .attr("y2", d => (y(d) ?? 0) + y.bandwidth())
    .attr("stroke", "#171b24")
    .attr("stroke-width", 1);

  // title label
  svgG.append("text")
    .attr("x", margin.left)
    .attr("y", 18)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Lanes: course · module (each task plotted by its date range)");
}



function startOfISOWeek(dt) {
    // Luxon weekday: Monday=1
    const diff = dt.weekday - 1;
    return dt.minus({ days: diff }).startOf("day");
  }

function drawSeverityLines(tasks) {
  svgH.selectAll("*").remove();

  const width = 1400;
  const height = 520;
  svgH.attr("width", width).attr("height", height);

  if (!tasks.length) return;

  const courses = uniqueSorted(tasks.map(t => t.course));

  const minISO = d3.min(tasks, d => d.startISO);
  const maxISO = d3.max(tasks, d => d.finishISO);

  const minDT = startOfISOWeek(DateTime.fromISO(minISO, { zone: "utc" }));
  const maxDT = startOfISOWeek(DateTime.fromISO(maxISO, { zone: "utc" }));

  // build week list
  const weeks = [];
  for (let d = minDT; d <= maxDT; d = d.plus({ weeks: 1 })) {
    weeks.push(d.toISODate());
  }

  // aggregate severity by course-week
  const key = (course, weekISO) => `${course}||${weekISO}`;
  const totals = new Map();

  for (const t of tasks) {
    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");

    for (let d = s; d <= f; d = d.plus({ days: 1 })) {
      const w = startOfISOWeek(d).toISODate();
      const k = key(t.course, w);
      totals.set(k, (totals.get(k) || 0) + t.severityPerDay);
    }
  }

  // shape data for lines
  const series = courses.map(course => ({
    course,
    values: weeks.map(w => ({
      weekISO: w,
      date: DateTime.fromISO(w, { zone: "utc" }).toJSDate(),
      value: totals.get(key(course, w)) || 0
    }))
  }));

  const maxVal = d3.max(series, s => d3.max(s.values, v => v.value)) || 1;

  const margin = { top: 30, right: 220, bottom: 40, left: 60 };
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const x = d3.scaleTime()
    .domain([DateTime.fromISO(weeks[0], { zone: "utc" }).toJSDate(),
             DateTime.fromISO(weeks[weeks.length - 1], { zone: "utc" }).plus({ weeks: 1 }).toJSDate()])
    .range([0, innerW]);

  const y = d3.scaleLinear()
    .domain([0, maxVal])
    .nice()
    .range([innerH, 0]);

  const g = svgH.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

  // grid
  g.append("g")
    .attr("class", "grid")
    .call(d3.axisLeft(y).ticks(6).tickSize(-innerW).tickFormat(() => ""));

  // axes
  g.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${innerH})`)
    .call(d3.axisBottom(x).ticks(d3.timeWeek.every(2)).tickFormat(d3.timeFormat("%d %b")));

  g.append("g")
    .attr("class", "axis")
    .call(d3.axisLeft(y).ticks(6));

  // line generator
  const line = d3.line()
    .x(d => x(d.date))
    .y(d => y(d.value))
    .curve(d3.curveMonotoneX);

  // colour per course (do not hardcode colours; use a default categorical scale)
  const colour = d3.scaleOrdinal()
    .domain(courses)
    .range(d3.schemeTableau10.concat(d3.schemeSet3).slice(0, Math.max(10, courses.length)));

  // draw lines
  const linesG = g.append("g");

  linesG.selectAll("path")
    .data(series)
    .enter()
    .append("path")
    .attr("fill", "none")
    .attr("stroke-width", 2)
    .attr("stroke", d => colour(d.course))
    .attr("d", d => line(d.values));

  // draw points for hover
  const points = linesG.selectAll("g.points")
    .data(series)
    .enter()
    .append("g")
    .attr("class", "points");

  points.selectAll("circle")
    .data(d => d.values.map(v => ({ ...v, course: d.course })))
    .enter()
    .append("circle")
    .attr("cx", d => x(d.date))
    .attr("cy", d => y(d.value))
    .attr("r", 3)
    .attr("fill", d => colour(d.course))
    .on("mousemove", function(evt, d) {
      const rect = evt.currentTarget.ownerSVGElement.getBoundingClientRect();
      const xPos = evt.clientX - rect.left + 14;
      const yPos = evt.clientY - rect.top + 14;
      const dt = DateTime.fromISO(d.weekISO, { zone: "utc" });

      tooltip.innerHTML =
        `<strong>${d.course}</strong>\n` +
        `Week commencing: ${dt.toFormat("dd LLL yyyy")}\n` +
        `Weekly severity: ${d.value.toFixed(0)}`;

      tooltip.style.opacity = "1";
      tooltip.style.transform = "translateY(0px)";
      tooltip.style.left = `${Math.min(xPos, rect.width - 340)}px`;
      tooltip.style.top = `${Math.min(yPos, rect.height - 160)}px`;
    })
    .on("mouseleave", hideTooltip);

  // legend (right side)
  const legend = svgH.append("g")
    .attr("transform", `translate(${margin.left + innerW + 14},${margin.top})`);

  legend.append("text")
    .attr("x", 0)
    .attr("y", 0)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Courses");

  const legendItems = legend.selectAll("g.item")
    .data(courses)
    .enter()
    .append("g")
    .attr("class", "item")
    .attr("transform", (d, i) => `translate(0,${16 + i * 16})`);

  legendItems.append("rect")
    .attr("x", 0)
    .attr("y", -10)
    .attr("width", 10)
    .attr("height", 10)
    .attr("rx", 3)
    .attr("ry", 3)
    .attr("fill", d => colour(d));

  legendItems.append("text")
    .attr("x", 16)
    .attr("y", -2)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 11)
    .text(d => d);
}

  function escapeHtml(str) {
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function renderCourseStats(tasks) {
    const el = document.getElementById("courseStatsBody");
    if (!el) return;

    if (!tasks || tasks.length === 0) {
      el.innerHTML = `<div class="note">No tasks to summarise (check filters).</div>`;
      if (statsMeta) statsMeta.innerHTML = "";
      return;
    }

    const byCourse = new Map();

    for (const t of tasks) {
      const course = t.course || "—";
      const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
      const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
      if (!s.isValid || !f.isValid) continue;

      const days = Math.max(1, Math.floor(f.diff(s, "days").days) + 1);
      const sev = (t.severityPerDay || 0) * days;

      if (!byCourse.has(course)) {
        byCourse.set(course, { course, totalSeverity: 0, totalTaskDays: 0, tasksCount: 0 });
      }
      const agg = byCourse.get(course);
      agg.totalSeverity += sev;
      agg.totalTaskDays += days;
      agg.tasksCount += 1;
    }

    const rows = Array.from(byCourse.values())
      .map(r => ({
        ...r,
        avgSeverityPerDay: r.totalTaskDays ? (r.totalSeverity / r.totalTaskDays) : 0
      }))
      .sort((a, b) => b.totalSeverity - a.totalSeverity);

    const totalSeverityAll = rows.reduce((acc, r) => acc + r.totalSeverity, 0);
    const totalTaskDaysAll = rows.reduce((acc, r) => acc + r.totalTaskDays, 0);
    const totalTasksAll = rows.reduce((acc, r) => acc + r.tasksCount, 0);

    const top = rows.slice(0, 10);

    if (statsMeta) {
      statsMeta.innerHTML = `
        <span class="pill"><strong>${rows.length}</strong> courses</span>
        <span class="pill"><strong>${totalTasksAll}</strong> tasks</span>
        <span class="pill"><strong>${totalSeverityAll.toFixed(0)}</strong> total severity</span>
      `;
    }

    el.innerHTML = `
      <div class="stats-kpi">
        <div class="box">
          <div class="big">${rows[0] ? escapeHtml(rows[0].course) : "—"}</div>
          <div class="small">Highest total severity</div>
        </div>
        <div class="box">
          <div class="big">${(rows[0] ? rows[0].totalSeverity : 0).toFixed(0)}</div>
          <div class="small">Top course severity</div>
        </div>
        <div class="box">
          <div class="big">${totalTaskDaysAll}</div>
          <div class="small">Task-days (all courses)</div>
        </div>
        <div class="box">
          <div class="big">${(totalTaskDaysAll ? (totalSeverityAll / totalTaskDaysAll) : 0).toFixed(2)}</div>
          <div class="small">Average severity per day (all)</div>
        </div>
      </div>

      <table class="stats-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Course</th>
            <th class="num">Total severity</th>
            <th class="num">Task-days</th>
            <th class="num">Tasks</th>
            <th class="num">Avg severity/day</th>
          </tr>
        </thead>
        <tbody>
          ${top.map((r, i) => `
            <tr>
              <td style="color:#aeb6c6;">${i + 1}</td>
              <td>${escapeHtml(r.course)}</td>
              <td class="num">${r.totalSeverity.toFixed(0)}</td>
              <td class="num">${r.totalTaskDays}</td>
              <td class="num">${r.tasksCount}</td>
              <td class="num">${r.avgSeverityPerDay.toFixed(2)}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    `;
  }


  
function drawHeatBlocks(tasks) {
  const svgB = d3.select("#heatBlocks");
  if (svgB.empty()) return;

  svgB.selectAll("*").remove();

  const width = 1400;

  if (!tasks || !tasks.length) {
    svgB.attr("width", width).attr("height", 120);
    return;
  }

  const courses = uniqueSorted(tasks.map(t => t.course));
  const minISO = d3.min(tasks, d => d.startISO);
  const maxISO = d3.max(tasks, d => d.finishISO);

  const minDT = startOfISOWeek(DateTime.fromISO(minISO, { zone: "utc" }));
  const maxDT = startOfISOWeek(DateTime.fromISO(maxISO, { zone: "utc" }));

  const weeks = [];
  for (let d = minDT; d <= maxDT; d = d.plus({ weeks: 1 })) {
    weeks.push(d.toISODate());
  }

  // Aggregate severity by course-week (sum of severity per day across all task days)
  const key = (course, weekISO) => `${course}||${weekISO}`;
  const totals = new Map();

  for (const t of tasks) {
    const s = DateTime.fromISO(t.startISO, { zone: "utc" }).startOf("day");
    const f = DateTime.fromISO(t.finishISO, { zone: "utc" }).startOf("day");
    if (!s.isValid || !f.isValid) continue;

    for (let d = s; d <= f; d = d.plus({ days: 1 })) {
      const w = startOfISOWeek(d).toISODate();
      const k = key(t.course, w);
      totals.set(k, (totals.get(k) || 0) + (t.severityPerDay || 0));
    }
  }

  const data = [];
  for (const c of courses) {
    for (const w of weeks) {
      data.push({ course: c, week: w, value: totals.get(key(c, w)) || 0 });
    }
  }

  const maxVal = d3.max(data, d => d.value) || 1;

  // dynamic height so labels do not collide (scroll happens in svgwrap)
  const rowH = 18;
  const height = Math.max(220, 70 + courses.length * rowH);

  svgB.attr("width", width).attr("height", height);

  const margin = { top: 30, right: 16, bottom: 40, left: 240 };
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const x = d3.scaleBand().domain(weeks).range([0, innerW]).padding(0.08);
  const y = d3.scaleBand().domain(courses).range([0, innerH]).padding(0.14);

  // Dark-to-light intensity. Keep within the existing palette.
  const colour = d3.scaleLinear()
    .domain([0, maxVal])
    .range(["rgba(15,17,24,1)", "rgba(255,107,107,0.85)"]);

  const g = svgB.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

  // axes (sparser x ticks)
  const tickWeeks = weeks.filter((_, i) => i % 2 === 0);
  const xAxis = d3.axisBottom(x).tickValues(tickWeeks).tickFormat(w => {
    const dt = DateTime.fromISO(w, { zone: "utc" });
    return dt.toFormat("dd LLL");
  });

  g.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${innerH})`)
    .call(xAxis)
    .selectAll("text")
    .attr("transform", "rotate(-30)")
    .style("text-anchor", "end");

  g.append("g")
    .attr("class", "axis")
    .call(d3.axisLeft(y).tickSize(0));

  g.selectAll("rect")
    .data(data)
    .enter()
    .append("rect")
    .attr("class", "heatcell")
    .attr("x", d => x(d.week))
    .attr("y", d => y(d.course))
    .attr("width", x.bandwidth())
    .attr("height", y.bandwidth())
    .attr("fill", d => colour(d.value))
    .on("mousemove", function(evt, d) {
      const rect = evt.currentTarget.ownerSVGElement.getBoundingClientRect();
      const xPos = evt.clientX - rect.left + 14;
      const yPos = evt.clientY - rect.top + 14;
      const dt = DateTime.fromISO(d.week, { zone: "utc" });

      tooltip.innerHTML =
        `<strong>${d.course}</strong>\n` +
        `Week commencing: ${dt.toFormat("dd LLL yyyy")}\n` +
        `Weekly severity: ${d.value.toFixed(0)}`;

      tooltip.style.opacity = "1";
      tooltip.style.transform = "translateY(0px)";
      tooltip.style.left = `${Math.min(xPos, rect.width - 340)}px`;
      tooltip.style.top = `${Math.min(yPos, rect.height - 160)}px`;
    })
    .on("mouseleave", hideTooltip);

  svgB.append("text")
    .attr("x", margin.left)
    .attr("y", 18)
    .attr("fill", "#aeb6c6")
    .attr("font-size", 12)
    .text("Weekly severity blocks by course (sheet).");
}


